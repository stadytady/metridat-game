[gd_resource type="Resource" script_class="Discovery" load_steps=2 format=3]

[ext_resource type="Script" path="res://scripts/interaction/discovery.gd" id="1_d"]

[resource]
script = ExtResource("1_d")
id = &"coin_stater"
title = "Gold stater of Panticapaeum"
location = "The Agora"
description = "A heavy gold coin. One side shows the bearded head of a satyr. The other shows a horned griffin standing on an ear of wheat, holding a spear in its jaws, above the letters PAN."
history = "Panticapaeum minted coins from the late 6th century BCE. In the second half of the 4th century BCE it struck gold staters with a satyr's head, often read as Pan in a pun on the city's name, and a griffin with a spear above an ear of grain, inscribed PAN. They are among the best-known Greek coins of the Black Sea."
sources = "G. K. Jenkins, Ancient Greek Coins (1972); C. M. Kraay, Archaic and Classical Greek Coins (1976)."
narrative = "A buyer left it on the stall and did not wait for change. The merchant says it is far too much money for one jar of fish sauce, and keeps it anyway."
